DATABASE_URL="postgresql://farqiah:farqiah@localhost:5432/farqiah?schema=public"
APP_URL="http://localhost:3000"
# On Render, omit APP_URL to use its automatically supplied RENDER_EXTERNAL_URL.
# Generate: openssl rand -hex 32
APP_SECRET="replace-with-a-random-secret-at-least-32-characters"
# Explicitly enables the requested silverhand / engineer demo account.
# Set false in production and set ADMIN_PASSWORD_HASH (see README).
DEMO_MODE="true"
ADMIN_USERNAME="silverhand"
ADMIN_PASSWORD_HASH=""
# Enable only behind a reverse proxy that overwrites X-Forwarded-For.
TRUST_PROXY="false"
